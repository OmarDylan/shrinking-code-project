FROM python:3.13-slim
# Scientific dependency versions from the successful r02 evaluation manifest.
RUN python -m pip install --no-cache-dir numpy==2.5.5 scipy==1.18.1 scikit-learn==1.9.1 pandas==3.1.1 cloudpickle==3.1.3 joblib==1.6.0 narwhals==2.29.0 python-dateutil==4.0.0 threadpoolctl==3.8.0 tzdata==2026.6
WORKDIR /repo
